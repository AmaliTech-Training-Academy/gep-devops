        <mxCell id="rv5woYXykiygoUiSsRmY-641" value="Architecture Notes" style="swimlane;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=13;fontStyle=1;startSize=25;labelBackgroundColor=none;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="3842" y="2890" width="540" height="220" as="geometry" />
        </mxCell>
        <mxCell id="rv5woYXykiygoUiSsRmY-642" value="Grafana Monitoring Infrastructure:&#xa;&#xa;• Grafana EC2 (t3.micro) for visualization dashboards&#xa;• Read-only access to PostgreSQL for metrics&#xa;• CloudWatch integration for AWS metrics &amp; logs&#xa;• ECS Fargate backend services with full DB access&#xa;• ElastiCache Redis for session management&#xa;• Systems Manager for secure instance access&#xa;• Multi-tier architecture (Public/Private subnets)&#xa;• NAT Gateway for outbound internet from private subnets&#xa;• SSL/TLS encryption via ACM&#xa;• IAM roles for least-privilege access&#xa;• Route 53 DNS management&#xa;• Centralized monitoring and observability" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9;spacingLeft=5;spacingTop=5;labelBackgroundColor=none;" vertex="1" parent="rv5woYXykiygoUiSsRmY-641">
          <mxGeometry x="10" y="35" width="520" height="175" as="geometry" />
        </mxCell>
        <mxCell id="rv5woYXykiygoUiSsRmY-643" value="🔒 Security Groups control all traffic between layers&#xa;• Public Subnet: Allows HTTPS (443) from Internet&#xa;• Private App: Allows traffic from ALB only&#xa;• Private Data: Allows traffic from App Subnet only" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9;spacingLeft=5;spacingTop=3;fontStyle=2;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="4422" y="2890" width="460" height="70" as="geometry" />
        </mxCell>
        <mxCell id="rv5woYXykiygoUiSsRmY-644" value="📊 Grafana Monitoring Capabilities:&#xa;• Real-time application metrics from PostgreSQL&#xa;• AWS infrastructure metrics from CloudWatch&#xa;• ECS container performance and logs&#xa;• Custom dashboards for business KPIs&#xa;• Alert configuration for anomaly detection" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9;spacingLeft=5;spacingTop=3;fontStyle=2;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="4422" y="2980" width="460" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rv5woYXykiygoUiSsRmY-645" value="Grafana Monitoring Infrastructure - Secure, Observable, Scalable" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=2;labelBackgroundColor=none;" vertex="1" parent="1">
