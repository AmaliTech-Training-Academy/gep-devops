        <mxCell id="rv5woYXykiygoUiSsRmY-387" value="All services are containerized using AWS Fargate&#xa;PostgreSQL uses multi-schema design for service isolation&#xa;Redis provides session management and caching&#xa;Async messaging via SNS/SQS for event-driven patterns" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=8;fontStyle=2;spacingLeft=5;spacingTop=3;labelBackgroundColor=none;" vertex="1" parent="rv5woYXykiygoUiSsRmY-376">
